{
  "name": "korzina",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.x"
  },
  "scripts": {
    "dev": "npm run platform:setup -- --local --seed && vite --host 0.0.0.0",
    "build": "vite build",
    "check": "cf workers types && tsc --noEmit && biome check . && npm run check:arch && vitest run",
    "check:arch": "node scripts/check-arch.ts",
    "deploy": "npm run check && npm run build && npm run platform:setup && cf deploy --prebuilt",
    "shop:create": "node scripts/shop-create.ts",
    "platform:setup": "node scripts/platform-setup.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "2.0.0-rc.0",
    "@cloudflare/vitest-plugin": "1.8.3",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cf": "1.0.0-rc.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
