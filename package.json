{
  "name": "korzina",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.x"
  },
  "scripts": {
    "dev": "npm run platform:setup -- --local --seed && vite --host 0.0.0.0",
    "build": "vite build --mode demo",
    "build:prod": "vite build --mode production",
    "check": "npm run check:fast && knip && vitest run && npm run check:build",
    "check:fast": "cf workers types && tsc --noEmit && biome check . && npm run check:arch",
    "check:build": "npm run build:prod && node scripts/check-bundle.ts --prod && npm run build && node scripts/check-bundle.ts",
    "check:arch": "node scripts/check-arch.ts",
    "test:related": "node scripts/test-related.ts",
    "test:e2e": "playwright test",
    "preview:upload": "node scripts/preview.ts",
    "smoke:demo": "node scripts/deployment-smoke.ts",
    "smoke:catalog": "node scripts/catalog-smoke.ts",
    "theme:export": "node scripts/export-theme.ts",
    "schema:shop": "node scripts/shop-schema.ts",
    "deploy": "npm run check && npm run platform:setup -- --seed && cf deploy --prebuilt",
    "admin:grant": "node scripts/admin-grant.ts",
    "shop:create": "node scripts/shop-create.ts",
    "flag": "node scripts/flag.ts",
    "platform:setup": "node scripts/platform-setup.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "leaflet": "^1.9.4",
    "libheif-js": "1.23.5",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.73.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-zoom-pan-pinch": "4.2.0",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "2.0.0-rc.0",
    "@cloudflare/vitest-plugin": "1.8.3",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cf": "1.0.0-rc.0",
    "drizzle-kit": "0.31.11",
    "happy-dom": "21.0.4",
    "knip": "6.45.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
