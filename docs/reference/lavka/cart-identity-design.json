  "logic": {
    "guest": "Show invitation only when no Telegram identity and no usable saved phone. Editing basket remains available.",
    "continue": "Resolve contact, then missing address via section 31, then current totals/stock via 35–36, then Receiving 37. Do not bypass contact on any Continue entry.",
    "telegram": "Server creates one-use browser-bound start=login_<token> deep link. Telegram bot receives /start token; server confirms this session; shop detects status on polling/focus/pageshow and closes login automatically, then resumes saved intent. First-time Telegram users may need Start; no manual check button in shop.",
    "phone": "Phone format validation and explicit ownership assertion; no SMS or call. Not verified ownership; never use arbitrary phone lookup to reveal another customer's profile, order history or balance.",
    "knownContact": "Do not ask again. Show saved phone and allow editing. Preserve cart, address, selected favorite product, promo and cashback mode.",
    "discountRefresh": "After login fetch eligible benefits and refresh basket. If totals change, show change before moving on.",
    "receiving": "No phone block or phone editing on Receiving. Collect and edit number in basket; return there to change it.",
    "cancel": "Close returns to previous basket; cart content preserved; Continue still gates absent contact.",
    "retry": "Failed or cancelled Telegram login offers retry and phone fallback. Phone submit/network error keeps input and confirmation, supports retry, prevents duplicate in-flight submission.",
    "mobile": "tel input/autofill; scrollable sheet above system keyboard; safe area respected.",
    "prototype": "Fixed inputs; after-timeout simulates a successful server-confirmed result, not real login. Errors are separate condition states.",
    "personalBenefits": "Both Telegram and phone login load account-bound favorite product, personal discounts, codes and cashback. Return to intended action automatically, without an additional Telegram gate."
  },
  "sourceEvidence": [
